{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kestrel/spec-strip",
	"version": "1.0.0",
	"title": "Spec Strip",
	"category": "widgets",
	"icon": "chart-line",
	"description": "Headline technical specs for a Kestrel product, rendered on the server from its spec fields.",
	"keywords": [ "specs", "product", "monitor" ],
	"textdomain": "kestrel",
	"attributes": {
		"productId": { "type": "integer", "default": 0 },
		"showName": { "type": "boolean", "default": true }
	},
	"supports": { "html": false, "align": [ "wide", "full" ] },
	"editorScript": "file:./editor.js"
}
